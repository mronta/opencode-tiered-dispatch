{
  "name": "opencode-tiered-dispatch",
  "version": "0.1.0",
  "description": "OpenCode V2 plugin for dispatching work to the cheapest adequate model tier",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build",
    "smoke:package": "node scripts/package-smoke.mjs",
    "smoke:opencode": "node scripts/opencode-smoke.mjs",
    "smoke:opencode:delegate": "node scripts/opencode-smoke.mjs --delegate",
    "smoke:opencode:permissions": "node scripts/opencode-smoke.mjs --delegate --permissions",
    "smoke:opencode:packed": "node scripts/opencode-smoke.mjs --packed",
    "smoke:opencode:packed:delegate": "node scripts/opencode-smoke.mjs --packed --delegate",
    "eval:routing": "node scripts/routing-evaluation.mjs"
  },
  "keywords": [
    "opencode",
    "plugin",
    "model-routing",
    "delegation"
  ],
  "license": "MIT",
  "dependencies": {
    "@opencode/plugin": "2.0.18"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.2",
    "vitest": "^3.2.4"
  }
}
